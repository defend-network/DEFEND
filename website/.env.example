# Public application configuration.
# Copy values into Cloudflare secrets/vars. Never commit real secret values.

APP_ENV=development
APP_URL=http://localhost:3000
PAYMENTS_MODE=test
PAYMENTS_LIVE_APPROVED=false
DONATIONS_ENABLED=false

# Required in deployed environments. Deployed environments fail closed when missing.
BETTER_AUTH_SECRET=
AUDIT_HASH_SALT=
PII_ENCRYPTION_KEY=
CARD_TOKEN_SECRET=

# Optional development-only Turnstile test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dedicated newsletter unsubscribe signing secret (falls back to card/auth secret).
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Stripe membership billing. Keep live charging disabled until approved.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email.
RESEND_API_KEY=

# Required by encrypted backup scripts/workflow; never commit the value.
BACKUP_PASSPHRASE=

# Public analytics/search verification values (build/runtime).
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
EMAIL_TRANSPORT=outbox
EMAIL_FROM=
