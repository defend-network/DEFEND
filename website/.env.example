# Public application configuration.
# Copy values into Cloudflare secrets/vars. Never commit real secret values.

APP_ENV=development
APP_URL=http://localhost:3000
PAYMENTS_MODE=test
PAYMENTS_LIVE_APPROVED=false
DONATIONS_ENABLED=false

# Required in deployed environments.
BETTER_AUTH_SECRET=
AUDIT_HASH_SALT=

# Optional development-only Turnstile test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
