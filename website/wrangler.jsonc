{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "defend-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "defend-website-dev",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "defend-private-documents"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "defend-public-media"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:3000",
    "PAYMENTS_MODE": "test",
    "PAYMENTS_LIVE_APPROVED": "false",
    "DONATIONS_ENABLED": "false"
  },
  "env": {
    "staging": {
      "name": "defend-website-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "defend-website-staging",
          "database_id": "f1f53b17-39e5-43ad-8b92-6f4c891da9fc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "defend-private-documents-staging"
        },
        {
          "binding": "MEDIA",
          "bucket_name": "defend-public-media-staging"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "APP_URL": "https://defend-website-staging.owner-e75.workers.dev",
        "EMAIL_TRANSPORT": "outbox",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "PAYMENTS_MODE": "test",
        "PAYMENTS_LIVE_APPROVED": "false",
        "DONATIONS_ENABLED": "false"
      }
    }
  }
}
